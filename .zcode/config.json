{
  "hooks": {
    "enabled": true,
    "events": {
      "SessionStart": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "python3 \"${ZCODE_PROJECT_DIR}/skills/hooks/engagement-init.py\"",
              "timeout": 40
            }
          ]
        },
        {
          "hooks": [
            {
              "type": "command",
              "command": "bash \"${ZCODE_PROJECT_DIR}/skills/hooks/session-start.sh\"",
              "timeout": 30
            }
          ]
        }
      ],
      "UserPromptSubmit": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "python3 \"${ZCODE_PROJECT_DIR}/skills/hooks/hunt-trigger.py\"",
              "timeout": 10
            }
          ]
        }
      ],
      "PreToolUse": [
        {
          "matcher": "Bash",
          "hooks": [
            {
              "type": "command",
              "command": "python3 \"${ZCODE_PROJECT_DIR}/skills/hooks/scope-guard.py\"",
              "timeout": 10
            },
            {
              "type": "command",
              "command": "python3 \"${ZCODE_PROJECT_DIR}/skills/hooks/sleep-guard.py\"",
              "timeout": 10
            },
            {
              "type": "command",
              "command": "python3 \"${ZCODE_PROJECT_DIR}/skills/hooks/drift-guard.py\"",
              "timeout": 10
            },
            {
              "type": "command",
              "command": "python3 \"${ZCODE_PROJECT_DIR}/skills/hooks/zg-nudge.py\"",
              "timeout": 10
            },
            {
              "type": "command",
              "command": "python3 \"${ZCODE_PROJECT_DIR}/skills/hooks/tmux-nudge.py\"",
              "timeout": 10
            },
            {
              "type": "command",
              "command": "python3 \"${ZCODE_PROJECT_DIR}/skills/hooks/burp-nudge.py\"",
              "timeout": 10
            },
            {
              "type": "command",
              "command": "python3 \"${ZCODE_PROJECT_DIR}/skills/hooks/lane-guard.py\"",
              "timeout": 10
            }
          ]
        },
        {
          "matcher": "Write|Edit",
          "hooks": [
            {
              "type": "command",
              "command": "python3 \"${ZCODE_PROJECT_DIR}/skills/hooks/session-guard.py\"",
              "timeout": 10
            },
            {
              "type": "command",
              "command": "python3 \"${ZCODE_PROJECT_DIR}/skills/hooks/eng-ckpt.py\"",
              "timeout": 10
            }
          ]
        },
        {
          "matcher": "Read",
          "hooks": [
            {
              "type": "command",
              "command": "python3 \"${ZCODE_PROJECT_DIR}/skills/hooks/big-read.py\"",
              "timeout": 10
            }
          ]
        }
      ],
      "PostToolUse": [
        {
          "matcher": "Bash",
          "hooks": [
            {
              "type": "command",
              "command": "python3 \"${ZCODE_PROJECT_DIR}/skills/hooks/recon-capture.py\"",
              "timeout": 30
            },
            {
              "type": "command",
              "command": "python3 \"${ZCODE_PROJECT_DIR}/skills/hooks/capture-poc.py\"",
              "timeout": 15
            }
          ]
        },
        {
          "hooks": [
            {
              "type": "command",
              "command": "python3 \"${ZCODE_PROJECT_DIR}/skills/hooks/tool-telemetry.py\"",
              "timeout": 10
            }
          ]
        },
        {
          "matcher": "Write|Edit",
          "hooks": [
            {
              "type": "command",
              "command": "python3 \"${ZCODE_PROJECT_DIR}/skills/hooks/wiki-reindex.py\"",
              "timeout": 10
            }
          ]
        }
      ],
      "Stop": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "python3 \"${ZCODE_PROJECT_DIR}/skills/hooks/close-out.py\"",
              "timeout": 10
            }
          ]
        }
      ],
      "PreCompact": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "bash \"${ZCODE_PROJECT_DIR}/skills/hooks/pre-compact.sh\"",
              "timeout": 10
            }
          ]
        }
      ]
    }
  }
}