# ============================================================================
#  ZTORCH .gitignore  (AGENTS.md / Codex flavour of TORCH)
#
#  PUBLIC (tracked):  wiki/ skills/ scripts/ setup/ docs/ tests/
#                     AGENTS.md  AGENTS.local.example.md  README.md  LICENSE
#  PRIVATE (ignored): targets/ (client engagements) + all machine/working state
# ============================================================================

# --- Client / engagement data: NEVER commit (hard boundary) -----------------
# Everything under targets/ is client-confidential. Only the generic
# engagement playbook (TARGETS.md) is shipped.
targets/*
!targets/TARGETS.md
# test fixtures ship a FAKE targets/ tree (no client data) - keep it
!tests/fixtures/offensive/targets/
!tests/fixtures/offensive/targets/**

# --- Machine-specific config (real hostnames, paths, local secrets) ---------
# AGENTS.local.md holds real hostnames/paths; the .example template DOES ship.
AGENTS.local.md
.claude/
.obsidian/

# --- Local working state (not part of the harness) --------------------------
session/
# raw/: keep the dir (research workspaces, cloned repos, assets) but ignore
# all contents; only the placeholder ships.
raw/*
!raw/.gitkeep

# --- Internal development notes (machine paths / client refs) ----------------
# Harness design plans/specs/handovers contain real machine paths; scrub before
# shipping if you ever want to publish them.
docs/superpowers/
docs/plans/
docs/specs/
# subagent-driven-development progress ledger (per-run session scratch)
.superpowers/

# --- Driver runtime cache (per-engagement, regenerated by `offensive.py index`)
.offensive-index.json

# --- Local hook toggles (per-machine kill-switch, never ship) ----------------
skills/hooks/.enforce-off

# --- Runtime stamps, telemetry, caches --------------------------------------
.trigger-fire.jsonl
.pending-*
.wiki-stamp
.wiki-reindex-stamp
.wiki-slug-index.json
.cve-stamp

# --- Python / pytest --------------------------------------------------------
__pycache__/
*.py[cod]
*.pyc
.pytest_cache/

# --- OS cruft ---------------------------------------------------------------
.DS_Store
Thumbs.db

# --- git worktrees ------------------------------------------------------------
.worktrees/
