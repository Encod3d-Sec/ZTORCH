+// minimal process.exit capture for the allowlist refusal path
+function jest_like_expect_exit(fn: Function, args: string[], env: Record<string, string | undefined>): string {
+  const origExit = process.exit
+  const origErr = console.error
+  let exited = false
+  ;(process as any).exit = ((code: number) => { exited = true; throw new Error("__exit__" + code) }) as any
+  console.error = () => {}
+  try {
+    fn(args, env)
+    return exited ? "refused" : "no-refusal"
+  } catch (e: any) {
+    return String(e.message).startsWith("__exit__") ? "refused" : "error:" + e.message
+  } finally {
+    process.exit = origExit
+    console.error = origErr
+  }
+}
