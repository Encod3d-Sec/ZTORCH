  * because every command had to repeat the flag; agents dropped it on the
  * cleanup and status calls.
  */
+interface ContextConfig {
+  defaultContext?: string
+  allowedContexts?: string[]
+}
+
+const CONTEXT_CONFIG_HINT = "context-config.json (defaultContext/allowedContexts, next to the daemon or $INTERCEPTOR_CONTEXT_CONFIG)"
+
+function readContextConfig(env: Record<string, string | undefined>): ContextConfig {
+  try {
+    // $INTERCEPTOR_CONTEXT_CONFIG wins. Implicit candidates, first readable wins:
+    //  - compiled exe: process.execPath = <root>/dist/interceptor.exe -> <root>/context-config.json
+    //  - dev/source run: process.argv[1] = <root>/cli/index.ts          -> <root>/context-config.json
+    const pathMod = require("node:path")
+    const fs = require("node:fs")
+    const pinned = env.INTERCEPTOR_CONTEXT_CONFIG?.trim()
+    const candidates = pinned
+      ? [pinned]
+      : [
+          pathMod.resolve(pathMod.dirname(process.execPath || ""), "../context-config.json"),
+          pathMod.resolve(pathMod.dirname(process.argv[1] || ""), "../context-config.json"),
+        ]
+    const path = candidates.find((c) => c && fs.existsSync(c))
+    if (!path) return {}
+    const raw = fs.readFileSync(path, "utf8")
+    const parsed = JSON.parse(raw)
+    if (parsed && typeof parsed === "object") return parsed as ContextConfig
+  } catch {
+    // absent/unreadable config = feature off; fall through
+  }
+  return {}
+}
+
 export function resolveContextId(args: string[], env: Record<string, string | undefined> = process.env): string | undefined {
+  const config = readContextConfig(env)
+  const allow = (config.allowedContexts ?? []).filter((x) => typeof x === "string" && x.length > 0)
   const explicit = parseContextFlag(args)
-  if (explicit !== undefined) return explicit
   const fromEnv = env.INTERCEPTOR_CONTEXT?.trim()
-  return fromEnv ? fromEnv : undefined
+  const resolved = explicit ?? (fromEnv && fromEnv.length > 0 ? fromEnv : undefined) ?? config.defaultContext
+  if (allow.length > 0 && resolved !== undefined && !allow.includes(resolved)) {
+    console.error(`error: context '${resolved}' is not in the allowlist (${allow.join(", ")}) - refusing to route to an unknown browser. Fix ${CONTEXT_CONFIG_HINT}.`)
+    process.exit(1)
+  }
+  return resolved
 }
 
